# Frontend configuration
FRONTEND_ORIGIN=http://localhost:3000

# Optional: override the SQLite file location (default: backend/nebula.db)
# NEBULA_DB_PATH=/path/to/nebula.db


# Ollama cloud LLM (https://ollama.com/settings/keys)
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_HOST=https://ollama.com
# Tried in order; first that responds is used
OLLAMA_MODELS=gemma4:31b-cloud,muse-spark-open:cloud
